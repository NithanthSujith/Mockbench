# Copy to .env:  cp .env.example .env
# Full variable reference: docs/specs/FND-10-api-skeleton.md (read by apps/api/src/config.ts only)

# Host port that serves BOTH the editor UI and the mock endpoints.
PORT=8080

POSTGRES_PASSWORD=mock

# PLACEHOLDER — fine for a trusted LAN, but change it. It keys the hash of session tokens.
# The api starts with this value but logs a warning.
SESSION_SECRET=change-me-this-is-a-placeholder-not-a-secret

# Set to true only if you serve the app over HTTPS. Must stay false on plain-HTTP LAN IPs.
COOKIE_SECURE=false
ALLOW_SIGNUP=true
SEED_DEMO=true
LOG_LEVEL=info
LOG_RETENTION_DAYS=7
LOG_RETENTION_ROWS=1000
# MOCK_RATE_LIMIT=            # requests/minute/IP on /mock; unset = unlimited
