# Mockbench configuration. Create your own with:  bash scripts/setup.sh  (Windows: scripts\setup.ps1)
# Full variable reference: docs/specs/FND-10-api-skeleton.md (read by apps/api/src/config.ts only)

# Host port that serves BOTH the editor UI and the mock endpoints.
PORT=8080

POSTGRES_PASSWORD=mock

# Keys the hash of session tokens; changing it signs everyone out of every device.
# scripts/setup.sh writes a unique random value here. The value below is a known placeholder
# kept so the test suites can boot from this file: the api starts with it but logs a warning.
SESSION_SECRET=change-me-this-is-a-placeholder-not-a-secret

# Set to true only if you serve the app over HTTPS. Must stay false on plain-HTTP LAN IPs.
COOKIE_SECURE=false
ALLOW_SIGNUP=true
SEED_DEMO=true
LOG_LEVEL=info
LOG_RETENTION_DAYS=7
LOG_RETENTION_ROWS=1000
# MOCK_RATE_LIMIT=            # requests/minute/IP on /mock; unset = unlimited
