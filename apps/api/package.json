{
  "name": "@mockbench/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/dev.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "build": "node build.mjs",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "devDependencies": {
    "@mockbench/tsconfig": "workspace:*",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.2",
    "tsx": "4.23.15"
  },
  "dependencies": {
    "@mockbench/api-contract": "workspace:*",
    "@mockbench/schema-core": "workspace:*",
    "cookie": "2.0.2",
    "drizzle-orm": "0.45.4",
    "express": "^5.3.0",
    "pg": "8.23.1",
    "pino": "10.4.0"
  }
}
