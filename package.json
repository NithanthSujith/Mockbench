{
  "name": "mockbench",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "dev": "echo \"dev servers arrive with FND-10 (api) and FND-13 (web)\"",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test && vitest run",
    "contract:docs": "node scripts/contract-docs.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@types/picomatch": "4.0.3",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "picomatch": "4.0.7",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "@mockbench/tsconfig": "workspace:*"
  }
}
