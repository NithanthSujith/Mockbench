{
  "name": "mockbench",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "dev": "pnpm --parallel --filter @mockbench/api --filter @mockbench/web dev",
    "db:migrate": "pnpm --filter @mockbench/api db:migrate",
    "db:generate": "pnpm --filter @mockbench/api db:generate",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test && vitest run",
    "contract:docs": "node scripts/contract-docs.mjs",
    "e2e": "bash e2e/run.sh",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "9.39.5",
    "@mockbench/tsconfig": "workspace:*",
    "@types/node": "22.20.5",
    "@types/picomatch": "4.0.3",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "picomatch": "4.0.7",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
