      "apps/api/src/modules/schema/**",
      "apps/web/src/features/routes/**",
      "apps/web/src/features/schema-builder/**",
      "apps/web/src/features/preview/**"
    ],
    "runtime": [
      "apps/api/src/modules/versions/**",
      "apps/api/src/modules/dataplane/**",
      "apps/api/src/modules/requests/**",
      "apps/api/src/seed/**",
