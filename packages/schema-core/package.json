{
  "name": "@mockbench/schema-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:node": "vitest run --project node",
    "test:browser-env": "vitest run --project browser-env",
    "test:update-goldens": "vitest run --project node -u"
  },
  "devDependencies": {
    "@mockbench/tsconfig": "workspace:*",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "happy-dom": "21.0.4"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "sizeLimit": {
    "gzipBytesExcludingZod": 9100,
    "gzipBytesIncludingZod": 112000,
    "gzipBytesValidateOnly": 2500,
    "gzipBytesGenerateOnly": 6100,
    "gzipBytesPreviewPath": 6600
  }
}
